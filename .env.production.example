APP_NAME="HR Celebration Scheduler"
APP_ENV=production
APP_KEY=                          # run: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://hr-scheduler.pivotmkg.com
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── Database (MySQL on Hostinger) ──────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=           # from Hostinger cPanel → MySQL Databases
DB_USERNAME=           # from Hostinger cPanel → MySQL Databases
DB_PASSWORD=           # the MySQL user password you set in cPanel

# ── Session / Cache / Queue ────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Mail (use Hostinger SMTP or keep Gmail App Password) ──────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ajaipivot@gmail.com
MAIL_PASSWORD=thapvigwqblagvdd
MAIL_FROM_ADDRESS="ajaipivot@gmail.com"
MAIL_FROM_NAME="HR Celebration Scheduler"
MAIL_ENCRYPTION=tls
# MAIL_VERIFY_PEER — do NOT set this on production (Linux doesn't need it)
